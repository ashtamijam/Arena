  <script>
    document.addEventListener('DOMContentLoaded', function () {
      // Smooth scroll for nav links
      document.querySelectorAll('[data-scroll-to]').forEach(function (link) {
        link.addEventListener('click', function (e) {
          e.preventDefault();
          var targetId = this.getAttribute('data-scroll-to');
          var target = document.getElementById(targetId);
          if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
          var mobileMenu = document.getElementById('mobile-menu');
          if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
            mobileMenu.classList.add('hidden');
          }
        });
      });

      // Scroll to order section
      document.querySelectorAll('[data-scroll-order]').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          var target = document.getElementById('order-section');
          if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });

      // Mobile nav toggle
      var navToggle = document.getElementById('nav-toggle');
      var mobileMenu = document.getElementById('mobile-menu');
      if (navToggle && mobileMenu) {
        navToggle.addEventListener('click', function () {
          mobileMenu.classList.toggle('hidden');
        });
      }

      // FAQ accordion
      document.querySelectorAll('.faq-item button').forEach(function (button) {
        button.addEventListener('click', function () {
          var parent = button.closest('.faq-item');
          parent.classList.toggle('active');
        });
      });

      // Stock urgency
      var stockEl = document.getElementById('stock-count');
      var stock = Math.floor(Math.random() * 8) + 19; // 19-26
      function renderStock() {
        if (stockEl) stockEl.textContent = stock;
      }
      renderStock();
      setInterval(function () {
        if (stock > 6) {
          stock--;
          renderStock();
        }
      }, 28000);

      // Offer countdown timer
      var timerEl = document.getElementById('offer-timer');
      var duration = 15 * 60;
      function updateTimer() {
        if (!timerEl) return;
        var mins = Math.floor(duration / 60);
        var secs = duration % 60;
        timerEl.textContent =
          (mins < 10 ? '0' + mins : mins) + ':' + (secs < 10 ? '0' + secs : secs);
      }
      updateTimer();
      setInterval(function () {
        duration--;
        if (duration <= 0) duration = 15 * 60;
        updateTimer();
      }, 1000);

      // Variant selection
      document.querySelectorAll('.variant-pill').forEach(function (pill) {
        pill.addEventListener('click', function () {
          var group = pill.getAttribute('data-group');
          if (group) {
            document
              .querySelectorAll('.variant-pill[data-group="' + group + '"]')
              .forEach(function (p) {
                p.classList.remove('selected');
              });
          }
          pill.classList.add('selected');
          var value = pill.getAttribute('data-value');
          var display = document.getElementById(group + '-value');
          if (display && value) display.textContent = value;
        });
      });

      // Pincode message
      var pincodeInput = document.getElementById('pincode');
      var pincodeMsg = document.getElementById('pincode-message');
      if (pincodeInput && pincodeMsg) {
        pincodeInput.addEventListener('blur', function () {
          var pin = pincodeInput.value.trim();
          if (pin.length === 6) {
            pincodeMsg.textContent =
              'Yes! We deliver to ' +
              pin +
              '. Estimated delivery in 4–7 working days via safe COD.';
            pincodeMsg.classList.remove('hidden');
          } else if (pin.length > 0) {
            pincodeMsg.textContent = 'Please enter a valid 6-digit Indian PIN code.';
            pincodeMsg.classList.remove('hidden');
          } else {
            pincodeMsg.classList.add('hidden');
          }
        });
      }

      // Form submit (demo)
      var orderForm = document.getElementById('cod-order-form');
      var formMessage = document.getElementById('form-message');
      if (orderForm && formMessage) {
        orderForm.addEventListener('submit', function (e) {
          e.preventDefault();
          formMessage.textContent =
            'Thank you! Your COD order has been received. Our team will confirm it via call or WhatsApp shortly.';
          formMessage.classList.remove('hidden');
          orderForm.reset();
        });
      }

      // WhatsApp buttons
      var waButtons = document.querySelectorAll('[data-whatsapp]');
      var waNumber = '919876543210'; // placeholder; replace with actual business number
      waButtons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var nameField = document.getElementById('full-name');
          var quantityField = document.getElementById('quantity');
          var name = nameField ? nameField.value.trim() : '';
          var quantity = quantityField ? quantityField.value : '1';
          var msg =
            'Hi ASHTAMI VERRA,%0A%0A' +
            'I want to order the Wooden Magnetic Door Bell (Buy 1 Get 1 Free) on Cash on Delivery.%0A' +
            'Quantity (sets of 2): ' +
            quantity +
            '%0A' +
            'Name: ' +
            (name || 'Not entered yet') +
            '%0A%0A' +
            'Please help me place my COD order.';
          var url = 'https://wa.me/' + waNumber + '?text=' + msg;
          window.open(url, '_blank');
        });
      });

      // Footer year
      var yearEl = document.getElementById('year');
      if (yearEl) {
        yearEl.textContent = new Date().getFullYear();
      }
    });
  </script>
